<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="#E7F1EB" />

            <stroke
                android:width="1dp"
                android:color="#AEC6B7" />

            <corners
                android:radius="10dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="1dp"
                android:color="#D8DEDA" />

            <corners
                android:radius="10dp" />

        </shape>
    </item>

</selector>