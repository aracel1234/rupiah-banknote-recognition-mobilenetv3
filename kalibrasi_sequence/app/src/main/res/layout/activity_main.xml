<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F6">

    <!-- ========================================================= -->
    <!-- HEADER + PEMILIHAN SEQUENCE                               -->
    <!-- Selalu terlihat                                           -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rupiah Sequence Collector"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/deviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#5F6368"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sequence yang akan direkam"
            android:textColor="#3C4043"
            android:textStyle="bold"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/sequenceSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:spinnerMode="dropdown" />

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- PREVIEW KAMERA                                            -->
    <!-- Rasio dinamis 4:3                                        -->
    <!-- ========================================================= -->

    <id.ac.ub.rupiah.sequence.AspectRatioFrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:background="#000000">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <!-- Crosshair vertikal -->
        <View
            android:layout_width="2dp"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:background="#CCFFFFFF" />

        <!-- Crosshair horizontal -->
        <View
            android:layout_width="58dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="#CCFFFFFF" />

        <!-- Instruksi aktif ketika sequence berjalan -->
        <TextView
            android:id="@+id/stageOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC000000"
            android:gravity="center_vertical"
            android:maxLines="4"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:text="Kamera belum siap"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

    </id.ac.ub.rupiah.sequence.AspectRatioFrameLayout>

    <!-- ========================================================= -->
    <!-- PROGRESS                                                  -->
    <!-- Selalu terlihat                                           -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/progressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/panel_background"
        android:maxLines="2"
        android:padding="8dp"
        android:textColor="#202124"
        android:textStyle="bold"
        android:textSize="12sp" />

    <!-- ========================================================= -->
    <!-- TOMBOL UTAMA                                              -->
    <!-- Selalu terlihat                                           -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/startButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:text="Mulai sequence"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/abortButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="0.55"
            android:layout_marginStart="6dp"
            android:enabled="false"
            android:minHeight="56dp"
            android:text="Batalkan"
            android:textAllCaps="false"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- BAGIAN DI BAWAH INI DAPAT DI-SCROLL                       -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="20dp">

            <!-- ================================================= -->
            <!-- PETUNJUK                                          -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Petunjuk sequence"
                android:textColor="#174F36"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/instructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/panel_background"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:textColor="#202124"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/noteInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="Catatan opsional untuk sequence ini"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textSize="12sp" />

            <!-- ================================================= -->
            <!-- PENYIMPANAN DAN KONFIGURASI                       -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Penyimpanan dan konfigurasi"
                android:textColor="#174F36"
                android:textStyle="bold"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/deviceAliasInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Alias perangkat"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/saveAliasButton"
                    android:layout_width="84dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:minHeight="48dp"
                    android:text="Simpan"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chooseDriveButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:minHeight="50dp"
                    android:text="Pilih folder Drive"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/syncButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:minHeight="50dp"
                    android:text="Sinkronkan"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

            </LinearLayout>

            <Button
                android:id="@+id/configButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:minHeight="50dp"
                android:text="Konfigurasi final 5.7.2"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/panel_background"
                android:lineSpacingExtra="1dp"
                android:padding="10dp"
                android:textColor="#3C4043"
                android:textSize="11sp" />

            <!-- ================================================= -->
            <!-- CHECKLIST                                         -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Daftar 40 sequence"
                android:textColor="#174F36"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/filterSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="2dp"
                android:spinnerMode="dropdown" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/checklistRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>