<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_background"
            android:lineSpacingExtra="2dp"
            android:padding="10dp"
            android:text="Masukkan hasil final Subbab 5.7.2. Setelah sequence pertama tersimpan, konfigurasi dikunci agar seluruh 40 urutan pada perangkat ini memakai preprocessing yang sama."
            android:textColor="#202124"
            android:textSize="12sp" />

        <!-- ROI -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Region of Interest (ROI)"
            android:textColor="#174F36"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Proporsi lebar ROI"
            android:textColor="#3C4043"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/roiSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <!-- QUALITY GATE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Pemeriksaan kualitas"
            android:textColor="#174F36"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/blurMinInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:hint="blur_variance_min"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <EditText
            android:id="@+id/lumaMinInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:hint="luma_min"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <EditText
            android:id="@+id/lumaMaxInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:hint="luma_max"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <!-- CLAHE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="CLAHE"
            android:textColor="#174F36"
            android:textStyle="bold"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/claheCheck"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Aktifkan CLAHE sesuai hasil 5.7.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clip limit"
            android:textColor="#3C4043"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/clipSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Grid CLAHE"
            android:textColor="#3C4043"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/gridSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <!-- CONFIRM -->

        <CheckBox
            android:id="@+id/confirmConfigCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_background"
            android:minHeight="56dp"
            android:padding="10dp"
            android:text="Saya mengonfirmasi nilai di atas merupakan hasil final 5.7.2 dan siap digunakan untuk seluruh pengumpulan sequence pada perangkat ini."
            android:textColor="#202124" />

    </LinearLayout>

</ScrollView>