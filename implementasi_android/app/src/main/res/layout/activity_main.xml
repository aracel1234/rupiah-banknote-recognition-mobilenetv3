<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFFFFF" android:padding="12dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/title" android:textSize="26sp" android:textStyle="bold"
        android:textColor="#111111" android:gravity="center" android:paddingBottom="8dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.camera.view.PreviewView android:id="@+id/preview"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" />
        <id.ac.ub.rupiah.ui.RoiOverlay android:id="@+id/roi"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/instruction" android:textSize="18sp" android:textColor="#111111"
        android:gravity="center" android:padding="8dp" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/preparing" android:lines="3" android:ellipsize="end" android:textSize="16sp" android:textColor="#111111"
        android:gravity="center" android:padding="6dp" />
    <TextView android:id="@+id/nominal" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/empty_nominal" android:textSize="28sp" android:textStyle="bold"
        android:textColor="#111111" android:gravity="center" android:padding="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/switchCamera" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="5dp" android:minHeight="56dp"
            android:background="@drawable/button_outline" android:text="@string/switch_camera"
            android:textAllCaps="false" android:textColor="#111111" android:textSize="16sp" />
        <Button android:id="@+id/toggle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="5dp" android:minHeight="56dp"
            android:background="@drawable/button_outline" android:text="@string/stop"
            android:textAllCaps="false" android:textColor="#111111" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
